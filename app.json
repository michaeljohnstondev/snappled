{
  "expo": {
    "name": "Snappled",
    "slug": "snapple-park",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "snappled",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bigvibestudios.snappled",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to record videos for prompts.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record audio with videos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive",
        "backgroundColor": "#00000000"
      },
      "adaptiveIcon": {
        "backgroundColor": "#001020"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.bigvibestudiosadmin.snapplepark"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Snappled to access your camera to record videos for prompts.",
          "microphonePermission": "Allow Snappled to access your microphone to record audio with videos."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "a9e37a08-f738-46fc-b005-13392ce18692"
      }
    },
    "owner": "bigvibestudiosadmin",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a9e37a08-f738-46fc-b005-13392ce18692"
    }
  }
}
