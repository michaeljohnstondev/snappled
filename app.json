{
  "expo": {
    "name": "Snappled",
    "slug": "snapple-park",
    "version": "1.0.1",
    "icon": "./assets/images/icon-apple.png",
    "orientation": "portrait",
    "scheme": "snappled",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.bigvibestudios.snappled",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Snappled uses the camera so you can record video for prompts.",
        "NSMicrophoneUsageDescription": "Snappled uses the microphone to record audio with your videos.",
        "NSPhotoLibraryUsageDescription": "Snappled lets you save your recorded snapples to your photo library.",
        "NSPhotoLibraryAddUsageDescription": "Snappled saves your recorded snapples to your photo library.",
        "NSLocationWhenInUseUsageDescription": "Snappled does not collect your location. This permission is required because the camera SDK can attach location metadata to videos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:snappled.com",
        "applinks:bigvibestudios.com"
      ]
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "immersive",
        "backgroundColor": "#00000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-android.png",
        "backgroundColor": "#001020"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.bigvibestudios.snappled",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "snappled.com",
              "pathPrefix": "/s"
            },
            {
              "scheme": "https",
              "host": "bigvibestudios.com",
              "pathPrefix": "/snappled/s"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow Snappled to access your camera to record videos for prompts.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Allow Snappled to access your microphone to record audio with videos."
        }
      ],
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.107855342657-26lrh6lcv0breonu2ffhkq19nbti8duo"
        }
      ],
      "expo-apple-authentication",
      "react-native-compressor",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "android_notification_icon": "./assets/images/notification-icon.png",
          "android_notification_color": "#00C6FF"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001020",
          "image": "./assets/images/icon-android.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/images/splash.png",
            "resizeMode": "cover",
            "backgroundColor": "#001020"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a9e37a08-f738-46fc-b005-13392ce18692"
      }
    },
    "owner": "bigvibestudiosadmin",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a9e37a08-f738-46fc-b005-13392ce18692"
    }
  }
}
