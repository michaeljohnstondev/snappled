# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
# This project is CNG - android/ and ios/ are GENERATED by prebuild
# (EAS does it server-side) and are not the source of truth. Committing
# them turns every app.json change into a merge conflict against
# machine-written files.
/android/
/ios/
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# Env / signing
.env
.env.*
!.env.example
credentials.json
credentials/

# Firebase deploy cache
.firebase/
