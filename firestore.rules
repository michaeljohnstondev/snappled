rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection rules
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow authenticated users to read user documents for username validation
      allow read: if request.auth != null;
      
      // Users can create their own user document
      allow create: if request.auth != null && request.auth.uid == userId
        && validateUserData(request.resource.data);
      
      // Users can update their own data with restrictions
      allow update: if request.auth != null && request.auth.uid == userId
        && validateUserUpdate(request.resource.data, resource.data);
      
      // Allow other users to update followers/following arrays (for follow functionality)
      allow update: if request.auth != null 
        && isFollowUpdate(request.resource.data, resource.data);
      
      // No delete allowed for user documents
      allow delete: if false;
    }
    
    // Videos collection rules (for user's uploaded videos)
    match /videos/{videoId} {
      // Users can read videos they created
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || 
         resource.data.isPublic == true);
      
      // Users can create videos
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        validateVideoData(request.resource.data);
      
      // Users can update their own videos
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Users can delete their own videos
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Snapples collection rules
    match /snapples/{snappleId} {
      // Anyone can read snapples that are publicly available
      allow read: if request.auth != null;
      
      // Only authenticated users can create snapples
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.creatorId &&
        validateSnappleData(request.resource.data);
      
      // Only creator can update snapple metadata, system can update engagement stats
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.creatorId ||
         isEngagementUpdate(request.resource.data, resource.data));
      
      // Only creator can delete snapple
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.creatorId;
    }
    
    // User interactions collection (likes/dislikes)
    match /user_interactions/{interactionId} {
      // Users can read their own interactions
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Users can create/update their own interactions
      allow create, update: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      
      // Users can delete their own interactions
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Wishlists collection rules
    match /wishlists/{wishlistId} {
      // Users can read their own wishlist items
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Users can create their own wishlist items
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
      
      // Users can delete their own wishlist items
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Reports collection rules
    match /reports/{reportId} {
      // Only the reporter can read their own reports
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.reporterId;
      
      // Users can create reports
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.reporterId;
      
      // No updates or deletes allowed (handled by moderation)
      allow update, delete: if false;
    }
    
    // Prompts collection rules
    match /prompts/{promptId} {
      // Anyone can read active prompts
      allow read: if request.auth != null;
      
      // Only authenticated users can create prompts
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.creatorId;
      
      // Only creator can update/delete prompts
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.creatorId;
    }
    
    // Hourly prompts collection rules
    match /hourlyPrompts/{promptId} {
      // Anyone can read hourly prompts
      allow read: if request.auth != null;
      
      // System can create hourly prompts
      allow create: if request.auth != null;
      
      // System can update hourly prompts (for engagement stats)
      allow update: if request.auth != null;
      
      // No delete allowed
      allow delete: if false;
    }
    
    // Snapple prompts collection rules (user-generated prompts)
    match /snapplePrompts/{promptId} {
      // Anyone can read snapple prompts
      allow read: if request.auth != null;
      
      // Any authenticated user can create prompts (will check for bans later)
      allow create: if request.auth != null;
      
      // Any authenticated user can update prompts (for likes/dislikes)
      allow update: if request.auth != null;
      
      // No delete allowed (handled by moderation)
      allow delete: if false;
    }
    
    // Prompt reports collection rules
    match /promptReports/{reportId} {
      // Any authenticated user can read/create/update prompt reports
      allow read, create, update: if request.auth != null;
      
      // No delete allowed (handled by moderation)
      allow delete: if false;
    }
    
    // Transactions collection rules
    match /transactions/{transactionId} {
      // Users can read their own transactions
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // System can create transactions (via server-side code)
      allow create: if request.auth != null;
      
      // No updates or deletes allowed
      allow update, delete: if false;
    }
    
    // Decks collection rules
    match /decks/{deckId} {
      // Users can read their own decks
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Users can create their own decks
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        validateDeckData(request.resource.data);
      
      // Users can update their own decks
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      
      // Users can delete their own decks
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Helper functions for validation
function validateUserData(data) {
  // Basic required fields validation
  return data.keys().hasAny(['uid']) && data.uid is string &&
    data.keys().hasAny(['username']) && data.username is string && 
    data.username.size() >= 3 && data.username.size() <= 20 &&
    data.keys().hasAny(['email']) && data.email is string && 
    data.email.matches('.*@.*') &&
    // Support both old and new resource structures
    ((data.keys().hasAny(['coins']) && data.coins is number && data.coins >= 0 &&
      data.keys().hasAny(['topicTokens']) && data.topicTokens is number && data.topicTokens >= 0) ||
     (data.keys().hasAny(['resources']) && 
      data.resources.keys().hasAny(['coins']) && data.resources.coins is number && data.resources.coins >= 0 &&
      data.resources.keys().hasAny(['tokens']) && data.resources.tokens is number && data.resources.tokens >= 0));
}

function validateUserUpdate(newData, oldData) {
  // Ensure critical fields can't be maliciously modified
  return newData.uid == oldData.uid &&
    newData.username == oldData.username &&
    newData.email == oldData.email &&
    newData.createdAt == oldData.createdAt &&
    // Allow resource updates with validation
    (('coins' in oldData && (newData.coins == oldData.coins || newData.coins >= 0) &&
      (newData.topicTokens == oldData.topicTokens || newData.topicTokens >= 0)) ||
     ('resources' in oldData && 'resources' in newData &&
      (newData.resources.coins == oldData.resources.coins || newData.resources.coins >= 0) &&
      (newData.resources.tokens == oldData.resources.tokens || newData.resources.tokens >= 0)));
}

function validateVideoData(data) {
  return data.keys().hasAll(['userId', 'prompt', 'videoUrl']) &&
    data.userId is string &&
    data.prompt is string &&
    data.videoUrl is string;
}

function validateSnappleData(data) {
  return data.keys().hasAll(['creatorId', 'promptId', 'videoId', 'basePrice']) &&
    data.creatorId is string &&
    data.promptId is string &&
    data.videoId is string &&
    data.basePrice is number && data.basePrice > 0;
}

function validateDeckData(data) {
  return data.keys().hasAll(['userId', 'name', 'snappleIds']) &&
    data.userId is string &&
    data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
    data.snappleIds is list;
}

function isEngagementUpdate(newData, oldData) {
  // Allow updates to engagement metrics (likes, dislikes, reports, etc.)
  return newData.creatorId == oldData.creatorId &&
    newData.promptId == oldData.promptId &&
    newData.videoId == oldData.videoId;
}

function isUsernameValidationQuery() {
  // Allow queries that are specifically for username validation
  // These queries should have a where clause on 'username' field
  return request.query != null && 
    request.query.limit != null && 
    request.query.limit <= 10;
}

function isFollowUpdate(newData, oldData) {
  // Allow updates that only modify social.followers/following arrays
  let socialChanged = newData.social != oldData.social;
  let updatedAtChanged = newData.updatedAt != oldData.updatedAt;
  
  // Check if only social fields and updatedAt changed
  return socialChanged && updatedAtChanged
    // And all other core fields remain unchanged
    && newData.uid == oldData.uid
    && newData.username == oldData.username
    && newData.email == oldData.email
    && newData.createdAt == oldData.createdAt;
}

