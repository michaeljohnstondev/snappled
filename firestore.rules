rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mirrors src/lib/admin.js and functions/gamePrompts.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['SrB8T1TmftQzu90H7phQkRJXkRn2'];
    }

    // Users - your own document, plus the one thing other people
    // legitimately do to yours: add or remove THEMSELVES from your
    // social lists.
    //
    // This used to be `allow update: if request.auth != null`, which
    // meant any signed-in account could write any other account's
    // document - set their own coins to a million, or empty someone
    // else's. It stayed open because follow and block genuinely write
    // to the other person's doc, so "own doc only" broke them. The fix
    // is to say precisely what a stranger may do instead of giving up.
    match /users/{userId} {

      // The keys that changed at the top level of the document.
      // affectedKeys() is top-level only, so a write to
      // 'social.followers' shows up here as 'social'.
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // A social list before and after, with the caller's own uid taken
      // out of both. If those match, the only thing the caller did to
      // that list was add or remove themselves - which is exactly what
      // following and blocking are. Anyone trying to drop a third party
      // from your followers, or stuff the list with ids that aren't
      // theirs, changes the comparison and is refused.
      //
      // get() with a default matters: older accounts predate some of
      // these lists, and reading a missing field would error the whole
      // rule into a denial.
      function onlySelfIn(list) {
        return request.resource.data.get('social', {}).get(list, [])
                 .removeAll([request.auth.uid])
            == resource.data.get('social', {}).get(list, [])
                 .removeAll([request.auth.uid]);
      }

      // What one user may do to another's document. Nothing but social,
      // and inside social nothing but their own membership.
      function isSocialWriteByOther() {
        return changed().hasOnly(['social', 'updatedAt'])
          && request.resource.data.get('social', {})
               .diff(resource.data.get('social', {})).affectedKeys()
               .hasOnly(['following', 'followers', 'blockedUsers', 'blockedBy'])
          && onlySelfIn('following')
          && onlySelfIn('followers')
          && onlySelfIn('blockedUsers')
          && onlySelfIn('blockedBy');
      }

      allow read: if request.auth != null;
      // Signup writes the starting balance, so create cannot simply
      // forbid resources the way update does — it can bound them. A new
      // account starts on 100 coins and 25 tickets; anything above that
      // is someone writing their own opening balance.
      //
      // These two numbers mirror STARTING_COINS and STARTING_TOPIC_TOKENS
      // in src/services/userService.js. Raise one there without raising
      // it here and every new signup is rejected — the account is created
      // in Auth and then has no document, which is a worse failure than
      // it sounds.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('resources', {}).get('coins', 0) <= 100
        && request.resource.data.get('resources', {}).get('tokens', 0) <= 25
        && request.resource.data.get('resources', {}).get('trophies', 0) == 0;
      // Everything with a price on it. None of these may be written by
      // any client, including on your own document: coins and tickets
      // are bought with real money, and the rest is what that money
      // buys. They are written by callables and triggers, which use the
      // Admin SDK and do not pass through these rules at all.
      //
      // stats is in the list because achievements pay out against it —
      // an editable stats.gamesWon is an editable coin balance with one
      // extra step.
      function ownedByServer() {
        return [
          'resources', 'inventory', 'upgrades', 'boosts',
          'achievements', 'purchases', 'stats', 'xpEarnedPrompts',
        ];
      }

      // profile holds bio and avatar, which people edit, alongside xp
      // and experience, which they must not. affectedKeys() cannot see
      // inside a map, so these two are compared by value.
      function profileXpUnchanged() {
        return request.resource.data.get('profile', {}).get('xp', 0)
                 == resource.data.get('profile', {}).get('xp', 0)
          && request.resource.data.get('profile', {}).get('experience', 0)
                 == resource.data.get('profile', {}).get('experience', 0);
      }

      // isAdmin covers the ban and grant buttons on AdminScreen, which
      // are the only client writes that are meant to reach past all of
      // this — and the only ones aimed at somebody else's document.
      allow update: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == userId
            && !changed().hasAny(ownedByServer())
            && profileXpUnchanged())
        || isSocialWriteByOther()
      );
      allow delete: if false;
    }

    // Videos - creator writes, anyone reads
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Snapples — public reads for non-private; private snapples are
    // only readable by the creator OR a grandfathered buyer who
    // already owned the snapple before it was flipped private (going
    // private only blocks NEW buys; existing owners keep access).
    // Uses .get(field, default) for both isPrivate and owners so a
    // single legacy doc without those fields can't reject the whole
    // query result set (Firestore rules apply per-doc and any single
    // failure rejects the entire query).
    match /snapples/{snappleId} {
      allow read: if request.auth != null && (
        resource.data.get('isPrivate', false) != true
        || request.auth.uid == resource.data.creatorId
        || request.auth.uid in resource.data.get('owners', [])
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Comments — read by anyone signed in. Updates stay open to any
    // authenticated user because the like counter and the parent's
    // reply counter are both written by people who aren't the author
    // (and so is a username rename fan-out). Deletes are author-only;
    // the client also soft-deletes via isDeleted for threads with
    // replies hanging off them.
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // User interactions (likes/dislikes) - any authenticated user
    match /user_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    // Wishlists - own data only
    match /wishlists/{wishlistId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Reports - create only
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Snapple prompts (user-generated)
    match /snapplePrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Share prompt codes - a short hash to the prompt text it stands
    // for, so a share link can carry a code instead of the whole prompt.
    //
    // Create-only, never updated. The code IS a hash of the text, so a
    // second write can only mean someone rewriting what a link already
    // sent to other people will say. Readable by anyone signed in; the
    // share page reads it with admin rights.
    match /sharePrompts/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow update, delete: if false;
    }

    // Prompt reports.
    //
    // The id is `<promptId>_<uid>` and the rule pins the uid half to the
    // caller, so one person files at most one report per prompt. That is
    // what makes auto-banning on a report COUNT safe: without it a
    // single user could reach the threshold alone and delete any prompt.
    match /promptReports/{reportId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reportId == request.resource.data.promptId + '_' + request.auth.uid;
      allow delete: if false;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Decks
    match /decks/{deckId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Games
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Active prompts (rotating)
    match /activePrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // On deck prompts (admin curated queue)
    match /onDeckPrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Prompt pool
    match /promptPool/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Prompt votes — one document per person per prompt.
    //
    // The id is `<target>_<promptId>_<uid>`, and the rule pins the uid
    // half to the caller. That is what makes the counts trustworthy:
    // a client can only ever create or change its OWN vote, so it
    // cannot stuff a prompt by writing rows on other people's behalf.
    // The count itself is written by the onPromptVoteWritten trigger,
    // never by a client.
    match /promptVotes/{voteId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && voteId == request.resource.data.target + '_'
          + request.resource.data.promptId + '_' + request.auth.uid
        && request.resource.data.value in [1, -1]
        && request.resource.data.target in ['activePrompts', 'promptPool', 'gamePrompts'];
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Recycled prompts
    match /recycledPrompts/{promptId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Game decks (pre-shuffled)
    match /gameDecks/{deckId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Game history (archived games)
    match /gameHistory/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Refunds ledger
    match /refunds/{refundId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // System locks
    match /system/{docId} {
      allow read, write: if request.auth != null;
    }

    // Join codes — a short code mapping to a game id, read off a screen
    // or spoken across a room. Readable by any signed-in client
    // (including the anonymous session a TV display uses) because
    // knowing the code IS the access grant; the code is what gates
    // which game you can find, not the rule.
    //
    // No update: a code points at one game for its lifetime. Delete is
    // open so a host can release one when the game ends.
    match /gameCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Game prompts
    // Game prompts.
    //
    // These were open to any signed-in user for create, update AND
    // delete - which, once players can pay for them, would let anyone
    // skip the fee, rewrite a live prompt that a whole room reads aloud,
    // flip a candidate straight to 'live', or delete the collection.
    //
    // Players create through the createGamePrompt function, which charges
    // the fee and checks the ban list in one transaction. The only write a
    // client may make directly is the usage bump when a game draws the
    // prompt, and only by exactly one.
    match /gamePrompts/{promptId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usageCount'])
          && request.resource.data.usageCount
            == resource.data.get('usageCount', 0) + 1);
    }

    // Season state. Read by everyone to show "Season N"; written only by
    // the rolloverSeason function.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Hourly prompts
    match /hourlyPrompts/{promptId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Banned prompt texts — admin-curated permaban list. Read by anyone
    // authenticated (so summonPrompt can check before creating). Write
    // open to authenticated users for now; admin gating happens client
    // side via the AdminScreen util.
    match /bannedPromptTexts/{textKey} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
