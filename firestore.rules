rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users - own data only
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Videos - creator writes, anyone reads
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Snapples — public reads for non-private; private snapples are
    // only readable by the creator OR a grandfathered buyer who
    // already owned the snapple before it was flipped private (going
    // private only blocks NEW buys; existing owners keep access).
    // Uses .get(field, default) for both isPrivate and owners so a
    // single legacy doc without those fields can't reject the whole
    // query result set (Firestore rules apply per-doc and any single
    // failure rejects the entire query).
    match /snapples/{snappleId} {
      allow read: if request.auth != null && (
        resource.data.get('isPrivate', false) != true
        || request.auth.uid == resource.data.creatorId
        || request.auth.uid in resource.data.get('owners', [])
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Comments — read by anyone signed in. Updates stay open to any
    // authenticated user because the like counter and the parent's
    // reply counter are both written by people who aren't the author
    // (and so is a username rename fan-out). Deletes are author-only;
    // the client also soft-deletes via isDeleted for threads with
    // replies hanging off them.
    match /comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // User interactions (likes/dislikes) - any authenticated user
    match /user_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    // Wishlists - own data only
    match /wishlists/{wishlistId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Reports - create only
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    // Snapple prompts (user-generated)
    match /snapplePrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Share prompt codes - a short hash to the prompt text it stands
    // for, so a share link can carry a code instead of the whole prompt.
    //
    // Create-only, never updated. The code IS a hash of the text, so a
    // second write can only mean someone rewriting what a link already
    // sent to other people will say. Readable by anyone signed in; the
    // share page reads it with admin rights.
    match /sharePrompts/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200;
      allow update, delete: if false;
    }

    // Prompt reports.
    //
    // The id is `<promptId>_<uid>` and the rule pins the uid half to the
    // caller, so one person files at most one report per prompt. That is
    // what makes auto-banning on a report COUNT safe: without it a
    // single user could reach the threshold alone and delete any prompt.
    match /promptReports/{reportId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && reportId == request.resource.data.promptId + '_' + request.auth.uid;
      allow delete: if false;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Decks
    match /decks/{deckId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Games
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Active prompts (rotating)
    match /activePrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // On deck prompts (admin curated queue)
    match /onDeckPrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Prompt pool
    match /promptPool/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Prompt votes — one document per person per prompt.
    //
    // The id is `<target>_<promptId>_<uid>`, and the rule pins the uid
    // half to the caller. That is what makes the counts trustworthy:
    // a client can only ever create or change its OWN vote, so it
    // cannot stuff a prompt by writing rows on other people's behalf.
    // The count itself is written by the onPromptVoteWritten trigger,
    // never by a client.
    match /promptVotes/{voteId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && voteId == request.resource.data.target + '_'
          + request.resource.data.promptId + '_' + request.auth.uid
        && request.resource.data.value in [1, -1]
        && request.resource.data.target in ['activePrompts', 'promptPool'];
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Recycled prompts
    match /recycledPrompts/{promptId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Game decks (pre-shuffled)
    match /gameDecks/{deckId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Game history (archived games)
    match /gameHistory/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Refunds ledger
    match /refunds/{refundId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // System locks
    match /system/{docId} {
      allow read, write: if request.auth != null;
    }

    // Join codes — a short code mapping to a game id, read off a screen
    // or spoken across a room. Readable by any signed-in client
    // (including the anonymous session a TV display uses) because
    // knowing the code IS the access grant; the code is what gates
    // which game you can find, not the rule.
    //
    // No update: a code points at one game for its lifetime. Delete is
    // open so a host can release one when the game ends.
    match /gameCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Game prompts
    match /gamePrompts/{promptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Hourly prompts
    match /hourlyPrompts/{promptId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Banned prompt texts — admin-curated permaban list. Read by anyone
    // authenticated (so summonPrompt can check before creating). Write
    // open to authenticated users for now; admin gating happens client
    // side via the AdminScreen util.
    match /bannedPromptTexts/{textKey} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
